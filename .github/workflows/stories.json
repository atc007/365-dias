name: Atualizar listas de stories (fotos de leitores)

on:
  push:
    branches: [main]
    paths:
      - '365-dep/**'
      - 'depoimentos-fotos/**'
      - '!365-dep/stories.json'
      - '!depoimentos-fotos/stories.json'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  gerar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Gerar stories.json de cada pasta
        run: |
          python3 - <<'PY'
          import os, json
          for pasta in ['365-dep', 'depoimentos-fotos']:
              if not os.path.isdir(pasta):
                  continue
              arquivos = sorted(f for f in os.listdir(pasta)
                                if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp')))
              with open(os.path.join(pasta, 'stories.json'), 'w', encoding='utf-8') as fh:
                  json.dump(arquivos, fh, ensure_ascii=False, indent=0)
              print(pasta, len(arquivos), 'imagens')
          PY

      - name: Salvar se mudou
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add 365-dep/stories.json depoimentos-fotos/stories.json
          git diff --cached --quiet || (git commit -m "Atualiza stories.json [skip ci]" && git push)
